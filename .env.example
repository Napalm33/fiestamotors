# Claves y configuración. Copia a .env y llena los valores. Nunca subas .env.
VITE_ELEVENLABS_AGENT_ID=
VITE_WHATSAPP_NUMBER=
# Modo texto del agente: "elevenlabs" (por defecto si hay ID) o "api" (backend propio).
VITE_AGENT_TEXT_PROVIDER=
# URL del backend del agente (POST JSON). Solo si el texto no va por ElevenLabs.
VITE_AGENT_API_URL=
