# Agente (widget). Todo VITE_* queda visible en el navegador: no pongas aquí claves secretas.
# ID del agente de ElevenLabs (agente público, con lista de dominios permitidos).
VITE_ELEVENLABS_AGENT_ID=
# Proveedor del modo texto: "elevenlabs" (por defecto si hay ID) o "api" (backend propio).
VITE_AGENT_TEXT_PROVIDER=
# URL del backend del agente (POST JSON). Solo si el texto no va por ElevenLabs.
VITE_AGENT_API_URL=
# Número de WhatsApp de prueba, solo dígitos con código de país (ej. 14165550123).
VITE_WHATSAPP_NUMBER=
